#!/usr/bin/env bash
# Configure /etc/hosts to redirect localhost and facebook.com

# Replace 127.0.0.1 with 127.0.0.2 for localhost
sed -i 's/127.0.0.1\tlocalhost/127.0.0.2\tlocalhost/g' /etc/hosts
sed -i 's/127.0.0.1 localhost/127.0.0.2 localhost/g' /etc/hosts

# Add or update facebook.com resolution to 8.8.8.8
if grep -q "facebook.com" /etc/hosts; then
    sed -i 's/.*facebook.com/8.8.8.8 facebook.com/g' /etc/hosts
else
    echo "8.8.8.8 facebook.com" >> /etc/hosts
fi

