#!/usr/bin/env bash
# Configure /etc/hosts to redirect localhost and facebook.com

if grep -q "facebook.com" /etc/hosts; then
    hosts_content=$(sed -e 's/127\.0\.0\.1\([[:space:]]\+\)localhost/127.0.0.2\1localhost/g' -e 's/[0-9.]\+[[:space:]]\+facebook.com/8.8.8.8 facebook.com/g' /etc/hosts)
else
    hosts_content=$(sed 's/127\.0\.0\.1\([[:space:]]\+\)localhost/127.0.0.2\1localhost/g' /etc/hosts)
    hosts_content=$(printf "%s\n8.8.8.8 facebook.com\n" "$hosts_content")
fi

echo "$hosts_content" > /etc/hosts
